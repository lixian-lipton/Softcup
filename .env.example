APP_DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM 模式: mock | local | api
LLM_MODE=mock

# 本地模型（只读，路径在项目外）
LOCAL_MODEL_PATH=/data/xli/Qwen3.5-0.8B
LLM_MAX_TOKENS=512
LLM_CONTEXT_CHARS=5000
LLM_API_TIMEOUT=120

# DeepSeek API（LLM_MODE=api 时填写）
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_API_MODEL=deepseek-chat

# 上传限制
MAX_UPLOAD_MB=8
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# 登录鉴权（可改成随机长字符串）
AUTH_SECRET=softcup-change-me-in-production
AUTH_TOKEN_HOURS=168
