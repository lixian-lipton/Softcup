APP_DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM 模式: mock | local | api
LLM_MODE=mock

# 本地模型目录（LLM_MODE=local 时填写）
LOCAL_MODEL_PATH=
LLM_MAX_TOKENS=512
LLM_CONTEXT_CHARS=5000
LLM_API_TIMEOUT=120

# DeepSeek API（LLM_MODE=api 时填写）
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_API_MODEL=deepseek-chat

# 上传限制
MAX_UPLOAD_MB=8
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# 登录鉴权（生产环境请改为足够长的随机串）
AUTH_SECRET=softcup-change-me-in-production
AUTH_TOKEN_HOURS=168

# 可选：首次创建/重置管理员时的口令（默认 123456）
# ADMIN_PASSWORD=123456
# SOFTCUP_RESET_ADMIN_PASSWORD=1

